# Server environment for docker compose. Copy to deploy/.env on the
# instance and fill values there — never commit real values.
#
# infra (used by compose, ignored by the app):
SITE_ADDRESS=:80
#   ":80"               serve plain HTTP on the instance IP
#   "demo.example.com"  automatic HTTPS (A record must point at the IP)
PUBLIC_URL=http://INSTANCE_IP
#   browser API base, baked into the frontend build. Must be the same
#   origin the dashboard is opened on: http://<ip> or https://<domain>.

# --- app (SPEC section 13) ---
MODE=cached
HARDWARE_MODE=simulated
HORIZON_MODE=today
HORIZON_TZ=America/Los_Angeles
START_SIMULATOR=1
DATABASE_URL=
DATA_DIR=/data
OPTIMIZER_MODE=real
CORS_ORIGINS=http://INSTANCE_IP
PHOTON_MODE=mock
PHOTON_TIMEOUT_SECONDS=300
OPERATOR_PHONE=
GEMINI_MODE=mock
GEMINI_MODEL=
GEMINI_API_KEY=
SOLANA_MODE=mock
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=
FETCHAI_MODE=local
DC_MAX_IT_KW=6.0
CURTAILMENT_SURPLUS_MW=50
EV_FORCE_DEADLINE=2026-06-21T21:00:00Z
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
